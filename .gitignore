# Android build artifacts + synced web assets (regenerated by :app:syncWebAssets)
android/app/src/main/assets/*
!android/app/src/main/assets/.gitkeep
android/.gradle/
android/build/
android/app/build/
android/local.properties

# Never commit signing material (CI holds it as Actions secrets)
*.jks
*.keystore
android/keystore.properties
